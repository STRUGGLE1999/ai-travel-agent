# Neon PostgreSQL Connection string; required for LIVE_PARTIAL.
DATABASE_URL=
# Optional isolated Neon branch for `npm run test:pg`. Do not reuse production DATABASE_URL.
# TEST_DATABASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
# Generate locally with: openssl rand -hex 32
RATE_LIMIT_SALT=
MAX_LLM_CALLS_PER_SESSION_PER_DAY=3
MAX_LLM_CALLS_PER_IP_PER_DAY=3
MAX_LLM_CALLS_GLOBAL_PER_DAY=100
MAX_SOURCE_INPUT_CHARS=20000
LLM_CACHE_TTL_SECONDS=86400
